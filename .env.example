# Shroom configuration. Copy to .env in the project root (/srv/hermes-web/.env);
# docker compose reads it automatically.

# Public hostname (or IP address) of the portal.
# Used as the nginx server_name and as the certificate directory:
# letsencrypt/live/$PORTAL_HOST/fullchain.pem and privkey.pem.
PORTAL_HOST=portal.example.com

# Exact origin browsers use to reach the portal (scheme + host, no trailing slash).
# State-changing API requests with any other Origin header are rejected.
# The acceptance tests send this value as their Origin header.
PORTAL_ORIGIN=https://portal.example.com
