[Unit]
Description=Hermes portal bridge for profile %i
After=network.target
[Service]
User=root
WorkingDirectory=/srv/hermes-web
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PORTAL_PROFILE=%i
ExecStart=/usr/bin/python3 /srv/hermes-web/bridge.py
Restart=on-failure
UMask=0077
[Install]
WantedBy=multi-user.target
