server {
 listen 80; server_name ${PORTAL_HOST};
 location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
 location / { return 301 https://${PORTAL_HOST}$request_uri; }
}
server {
 listen 443 ssl; server_name ${PORTAL_HOST};
 http2 on;   # many parallel /api polls and lazy chunks share one connection
 ssl_session_cache shared:SSL:5m; ssl_session_timeout 1d;
 ssl_certificate /etc/letsencrypt/live/${PORTAL_HOST}/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/${PORTAL_HOST}/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 client_max_body_size 12m;
 add_header X-Content-Type-Options nosniff always;
 add_header X-Frame-Options DENY always;
 add_header Referrer-Policy same-origin always;
 add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;
 gzip on; gzip_comp_level 5; gzip_min_length 1024; gzip_proxied any; gzip_vary on;
 gzip_types text/css application/javascript application/json image/svg+xml text/plain;
 location /api/ {
  proxy_pass http://backend:8000;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_buffering off;
  proxy_read_timeout 1000s;
 }
 location / { proxy_pass http://frontend:80; proxy_set_header Host $host; }
}
